#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
IGNORE_FILE="$ROOT_DIR/.gittypeignore"
SOURCE_DIRS=(
    "$ROOT_DIR/core-drills/src/main"
    "$ROOT_DIR/spring-drills/src/main"
    "$ROOT_DIR/integration-drills/src/main"
)

usage() {
    cat <<'EOF'
Usage:
  bin/train [--fresh] <topic> [l1|l2|l3|l4|l5]
  bin/train [--fresh] l1|l2|l3|l4|l5
  bin/train [--topics a,b] [--levels 1,2] [--tags a,b] [--lang java|kotlin]

Examples:
  bin/train streams l2
  bin/train l3
  bin/train --topics kafka,springdata --levels 2,3
  bin/train --tags groupingBy,tx --lang java
EOF
}

csv_has() {
    local csv needle
    csv=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    needle=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
    [[ ",$csv," == *",$needle,"* ]]
}

matches_any_tag() {
    local actual=$1 requested=$2 wanted
    local old_ifs=$IFS
    IFS=,
    for wanted in $requested; do
        if csv_has "$actual" "$wanted"; then
            IFS=$old_ifs
            return 0
        fi
    done
    IFS=$old_ifs
    return 1
}

fresh=false
topics=""
levels=""
tags=""
language=""
positionals=()

while (( $# > 0 )); do
    case "$1" in
        --fresh) fresh=true; shift ;;
        --topics|--levels|--tags|--lang)
            (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 2; }
            option=$1
            value=$2
            shift 2
            case "$option" in
                --topics) topics=$value ;;
                --levels) levels=$value ;;
                --tags) tags=$value ;;
                --lang) language=$value ;;
            esac
            ;;
        --topics=*) topics=${1#*=}; shift ;;
        --levels=*) levels=${1#*=}; shift ;;
        --tags=*) tags=${1#*=}; shift ;;
        --lang=*) language=${1#*=}; shift ;;
        -h|--help) usage; exit 0 ;;
        --*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) positionals+=("$1"); shift ;;
    esac
done

if (( ${#positionals[@]} > 2 )); then
    usage >&2
    exit 2
fi
if (( ${#positionals[@]} > 0 )); then
    if [[ ${positionals[0]} =~ ^l[1-5]$ ]]; then
        [[ -z "$levels" && ${#positionals[@]} == 1 ]] || { usage >&2; exit 2; }
        levels=${positionals[0]#l}
    else
        [[ -z "$topics" ]] || { usage >&2; exit 2; }
        topics=${positionals[0]}
        if (( ${#positionals[@]} == 2 )); then
            [[ ${positionals[1]} =~ ^l[1-5]$ && -z "$levels" ]] || { usage >&2; exit 2; }
            levels=${positionals[1]#l}
        fi
    fi
fi

levels=$(printf '%s' "$levels" | sed -E 's/(^|,)l/\1/g')
[[ -z "$levels" || "$levels" =~ ^[1-5](,[1-5])*$ ]] || { echo "Invalid levels: $levels" >&2; exit 2; }
[[ -z "$language" || "$language" == java || "$language" == kotlin ]] || {
    echo "Language must be java or kotlin" >&2
    exit 2
}
[[ -n "$topics$levels$tags$language" ]] || { usage >&2; exit 2; }

all_files=$(mktemp "${TMPDIR:-/tmp}/trainer-all.XXXXXX")
selected_files=$(mktemp "${TMPDIR:-/tmp}/trainer-selected.XXXXXX")
trap 'rm -f "$all_files" "$selected_files"' EXIT

find "${SOURCE_DIRS[@]}" -type f \( -name '*.java' -o -name '*.kt' \) | sort > "$all_files"
while IFS= read -r file; do
    task_id=$(sed -n 's|^// @task ||p' "$file" | head -1)
    [[ -n "$task_id" ]] || continue
    task_topic=${task_id%%.*}
    task_tail=${task_id#*.}
    task_level=${task_tail%%.*}
    task_level=${task_level#l}
    task_language=java
    [[ "$file" == *.kt ]] && task_language=kotlin
    task_tags=$(sed -n 's|^// @tags ||p' "$file" | head -1)

    [[ -z "$topics" ]] || csv_has "$topics" "$task_topic" || continue
    [[ -z "$levels" ]] || csv_has "$levels" "$task_level" || continue
    [[ -z "$language" || "$language" == "$task_language" ]] || continue
    [[ -z "$tags" ]] || matches_any_tag "$task_tags" "$tags" || continue
    printf '%s\n' "$file" >> "$selected_files"
done < "$all_files"

file_count=$(wc -l < "$selected_files" | tr -d ' ')
if (( file_count == 0 )); then
    echo "No exercises match the selector" >&2
    exit 1
fi

languages=$(sed -E 's/.*\.//' "$selected_files" | sed 's/^kt$/kotlin/' | sort -u | paste -sd, -)
selector="topics=${topics:-*};levels=${levels:-*};tags=${tags:-*};lang=${language:-*}"

direct=false
if [[ -n "$topics" && "$topics" != *,* && -z "$tags" && -z "$language" && "$levels" != *,* ]]; then
    first_file=$(head -1 "$selected_files")
    module_path=${first_file#"$ROOT_DIR/"}
    module_path=${module_path%%/src/main/*}
    source_language=java
    [[ "$first_file" == *.kt ]] && source_language=kotlin
    target="$module_path/src/main/$source_language/trainer/$topics"
    [[ -z "$levels" ]] || target="$target/l$levels"
    direct=true
fi

cd "$ROOT_DIR"
if [[ "$direct" == true ]]; then
    rm -f "$IGNORE_FILE"
    playlist_target=$target
else
    {
        printf '# GENERATED by bin/train — selector: %s\n' "$selector"
        printf '# Do not edit, do not commit.\n/arena/\n/fixtures/\n/docs/\n/*/src/test/\n'
        while IFS= read -r file; do
            if ! grep -Fqx "$file" "$selected_files"; then
                printf '/%s\n' "${file#"$ROOT_DIR/"}"
            fi
        done < "$all_files"
    } > "$IGNORE_FILE"
    playlist_target=.
fi

echo "Playlist: $selector ($file_count file(s), $languages)"
if [[ ${TRAINER_DRY_RUN:-0} == 1 ]]; then
    while IFS= read -r file; do sed -n 's|^// @task |  |p' "$file"; done < "$selected_files"
    exit 0
fi
command -v gittype >/dev/null 2>&1 || { echo "gittype is not installed" >&2; exit 127; }
if [[ "$fresh" == true ]]; then
    gittype cache clear
fi
exec gittype "$playlist_target" --langs "$languages"
