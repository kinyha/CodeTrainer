#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

usage() {
    cat <<'EOF'
Usage:
  bin/trainer new <task-id>
  bin/trainer diff <task-id>
  bin/trainer index
  bin/trainer clean

Examples:
  bin/trainer new streams.l2.AvgSalaryByDepartment
  bin/trainer diff streams.l2.AvgSalaryByDepartment
EOF
}

find_reference() {
    local task_id=$1
    local matches

    matches=$(rg -F -x -l --glob '*.java' --glob '*.kt' \
        "// @task $task_id" \
        "$ROOT_DIR/core-drills/src/main" \
        "$ROOT_DIR/spring-drills/src/main" \
        "$ROOT_DIR/integration-drills/src/main" 2>/dev/null || true)

    if [[ -z "$matches" ]]; then
        echo "Unknown task: $task_id" >&2
        return 1
    fi

    if [[ $(printf '%s\n' "$matches" | wc -l | tr -d ' ') != 1 ]]; then
        echo "Task id is not unique: $task_id" >&2
        printf '%s\n' "$matches" >&2
        return 1
    fi

    printf '%s\n' "$matches"
}

task_paths() {
    local task_id=$1
    local source_file
    source_file=$(find_reference "$task_id") || return 1

    local module_dir=${source_file%%/src/main/*}
    local source_relative=${source_file#*/src/main/}
    local extension=${source_file##*.}
    local without_extension=${source_relative%.*}
    local task_basename
    task_basename=$(basename "$without_extension")

    REFERENCE_FILE=$source_file
    REFERENCE_TEST="$module_dir/src/test/${without_extension}Test.$extension"
    REFERENCE_TEST_ROOT="$module_dir/src/test"
    REFERENCE_TEST_DIR=$(dirname "$REFERENCE_TEST")
    REFERENCE_TEST_PATTERN="${task_basename}*Test.$extension"
    ARENA_FILE="$ROOT_DIR/arena/src/main/$source_relative"
    ARENA_TEST="$ROOT_DIR/arena/src/test/${without_extension}Test.$extension"
    ARENA_TEST_DIR=$(dirname "$ARENA_TEST")
    REFERENCE_RESOURCES="$module_dir/src/test/resources"
    ARENA_RESOURCES="$ROOT_DIR/arena/src/test/resources"
    SOURCE_EXTENSION=$extension
}

strip_solution() {
    local source_file=$1
    local extension=$2
    local destination=$3

    awk -v extension="$extension" '
        /\/\/ ---8<--- solution/ {
            found++
            skipping = 1
            match($0, /[^[:space:]]/)
            indent = substr($0, 1, RSTART - 1)
            if (extension == "kt") {
                print indent "TODO(\"implement\")"
            } else {
                print indent "throw new UnsupportedOperationException(\"TODO: implement\");"
            }
            next
        }
        /\/\/ --->8--- solution/ {
            if (!skipping) {
                invalid = 1
            }
            skipping = 0
            next
        }
        !skipping { print }
        END {
            if (skipping || invalid || found == 0) {
                exit 42
            }
        }
    ' "$source_file" > "$destination"
}

new_task() {
    local task_id=$1
    task_paths "$task_id"

    if [[ ! -f "$REFERENCE_TEST" ]]; then
        echo "Reference test is missing: $REFERENCE_TEST" >&2
        exit 1
    fi
    if [[ -e "$ARENA_FILE" || -e "$ARENA_TEST" ]]; then
        echo "Arena already contains $task_id; use 'bin/trainer clean' first" >&2
        exit 1
    fi

    local temporary_file
    temporary_file=$(mktemp "${TMPDIR:-/tmp}/trainer.XXXXXX")

    if ! strip_solution "$REFERENCE_FILE" "$SOURCE_EXTENSION" "$temporary_file"; then
        rm -f "$temporary_file"
        echo "Invalid or missing solution markers in $REFERENCE_FILE" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$ARENA_FILE")" "$ARENA_TEST_DIR"
    mv "$temporary_file" "$ARENA_FILE"
    while IFS= read -r supporting_test; do
        cp "$supporting_test" "$ARENA_TEST_DIR/"
    done < <(find "$REFERENCE_TEST_DIR" -maxdepth 1 -type f -name "$REFERENCE_TEST_PATTERN" -print)
    while IFS= read -r test_support; do
        local support_relative=${test_support#"$REFERENCE_TEST_ROOT/"}
        local support_destination="$ROOT_DIR/arena/src/test/$support_relative"
        mkdir -p "$(dirname "$support_destination")"
        cp "$test_support" "$support_destination"
    done < <(find "$REFERENCE_TEST_ROOT" -type f -name '*TestSupport.java' -print)
    if [[ -d "$REFERENCE_RESOURCES" ]]; then
        mkdir -p "$ARENA_RESOURCES"
        cp -R "$REFERENCE_RESOURCES/." "$ARENA_RESOURCES/"
    fi

    echo "Created recall exercise:"
    echo "  $ARENA_FILE"
    echo "  $ARENA_TEST"
    echo "Run: ./gradlew :arena:test"
}

diff_task() {
    local task_id=$1
    task_paths "$task_id"

    if [[ ! -f "$ARENA_FILE" ]]; then
        echo "Task is not present in arena: $task_id" >&2
        exit 1
    fi

    diff -u --label "arena/$task_id" --label "reference/$task_id" \
        "$ARENA_FILE" "$REFERENCE_FILE" || true
}

clean_arena() {
    local arena_sources="$ROOT_DIR/arena/src"
    if [[ ! -d "$arena_sources" ]]; then
        echo "Arena is already empty"
        return
    fi

    rm -rf "$arena_sources"
    echo "Removed generated arena sources"
}

generate_index() {
    local destination="$ROOT_DIR/docs/CATALOG.md"
    local temporary_file
    temporary_file=$(mktemp "${TMPDIR:-/tmp}/trainer-catalog.XXXXXX")

    {
        echo '# Каталог упражнений'
        echo
        echo '<!-- GENERATED by bin/trainer index. Do not edit manually. -->'
        echo
        echo '| ID | Теги | Recall | Исходник |'
        echo '|---|---|---:|---|'
        while IFS= read -r source_file; do
            local task_id tags recall relative
            task_id=$(sed -n 's|^// @task ||p' "$source_file" | head -1)
            tags=$(sed -n 's|^// @tags ||p' "$source_file" | head -1)
            recall=$(sed -n 's|^// @time ||p' "$source_file" | head -1)
            relative=${source_file#"$ROOT_DIR/"}
            printf '| `%s` | %s | %s | [%s](../%s) |\n' \
                "$task_id" "${tags//,/, }" "${recall:--}" "$relative" "$relative"
        done < <(rg -l '^// @task ' \
            "$ROOT_DIR/core-drills/src/main" \
            "$ROOT_DIR/spring-drills/src/main" \
            "$ROOT_DIR/integration-drills/src/main" | sort)
    } > "$temporary_file"

    mkdir -p "$(dirname "$destination")"
    mv "$temporary_file" "$destination"
    echo "Generated $destination"
}

if (( $# < 1 )); then
    usage >&2
    exit 2
fi

command_name=$1
shift

case "$command_name" in
    new)
        (( $# == 1 )) || { usage >&2; exit 2; }
        new_task "$1"
        ;;
    diff)
        (( $# == 1 )) || { usage >&2; exit 2; }
        diff_task "$1"
        ;;
    clean)
        (( $# == 0 )) || { usage >&2; exit 2; }
        clean_arena
        ;;
    index)
        (( $# == 0 )) || { usage >&2; exit 2; }
        generate_index
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        usage >&2
        exit 2
        ;;
esac
